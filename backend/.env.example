# ── AI API Keys ──
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# ── JWT (REQUIRED — must be a strong random string, min 32 chars) ──
JWT_SECRET=change-me-to-a-secure-random-string-min-32-characters

# ── Database ──
# Default: SQLite (for development)
# For production use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/legalai
DATABASE_URL=sqlite:///./legal_assistant.db

# ── Twilio SMS (optional — uses mock mode if not set, code: 111111) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── App Settings ──
# DEBUG_MODE=true allows test OTP code 111111. NEVER enable in production!
DEBUG_MODE=true

# Rate limit for API endpoints (format: "X/minute" or "X/hour")
RATE_LIMIT=10/minute
